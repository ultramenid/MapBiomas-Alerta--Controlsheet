# Uploads are data, never code. Apache only; on nginx add the equivalent location block.
<FilesMatch "\.(php\d?|phtml|phar|pht|phps|shtml|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>
Options -ExecCGI -Indexes
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
RemoveHandler .php .phtml .phar
RemoveType .php .phtml .phar
